# Perfil: consultorio — recepção consultório (voz masculina)
# Renomeie para config.toml e coloque na mesma pasta do klingo-launcher.exe.

[klingo]
url = "PREENCHER"            # https://ioba.klingo.app/#/
usuario = "PREENCHER"        # mesmo usuário para todas as máquinas
senha = "PREENCHER"

[painel]
modo = "painel"                  # "painel" ou "totem"
# Nomes EXATOS como aparecem na janela "Localização" da Klingo (acentos e maiúsculas não importam):
unidade = "Instituto Oftalmológico da Bahia"
recepcao = "RECEPCAO CONSULTORIO"              # RECEPCAO CONSULTORIO | RECEPCAO FARMACIA | RECEPÇÃO PARTICULAR | RECEPÇÃO SUS
totem_botao = ""           # só no modo totem: texto exato do botão na janela Localização
voz = "Antonio"                   # só no modo painel: nome ou pedaço (Francisca, Antonio, Thalita). Veja com --vozes
link = ""                    # vazio = o exe descobre o link sozinho (com login) e guarda em links.json

[tempos]
atraso_inicial_seg = 15      # espera antes de começar (internet subir)
espera_internet_max_seg = 300
espera_pausado_seg = 90      # se aparecer "Pausado devido a segundo acesso", espera isto...
jitter_max_seg = 30          # ...mais um sorteio de 0 a N s, e então clica em Retomar
max_tentativas = 10          # máximo de pausas seguidas antes de desistir
timeout_passo_seg = 30

[edge]
caminho = ""                 # vazio = acha o Edge sozinho
porta_cdp = 9222

[desligamento]
ativo = true                  # false = não desliga sozinho
horario = "18:00"            # o exe fica rodando escondido até esta hora e desliga
aviso_seg = 60               # caixa de aviso com botão Cancelar antes de desligar
espera_fechar_apps_seg = 30  # tempo para os apps fecharem sozinhos
forcar = true                # depois da espera, força o que sobrou (evita travar na tela de desligar)
